{
  "chekan": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/chekan_hook.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/chekan_hook.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ./hooks/chekan_hook.py",
        "timeout": 15
      }
    ]
  }
}
