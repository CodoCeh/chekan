{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$(command -v py >/dev/null 2>&1 && echo py -3 || echo python3) \"${CLAUDE_PLUGIN_ROOT}\"/hooks/chekan_hook.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$(command -v py >/dev/null 2>&1 && echo py -3 || echo python3) \"${CLAUDE_PLUGIN_ROOT}\"/hooks/chekan_hook.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "$(command -v py >/dev/null 2>&1 && echo py -3 || echo python3) \"${CLAUDE_PLUGIN_ROOT}\"/hooks/chekan_hook.py",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$(command -v py >/dev/null 2>&1 && echo py -3 || echo python3) \"${CLAUDE_PLUGIN_ROOT}\"/hooks/chekan_hook.py",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$(command -v py >/dev/null 2>&1 && echo py -3 || echo python3) \"${CLAUDE_PLUGIN_ROOT}\"/hooks/chekan_hook.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "$(command -v py >/dev/null 2>&1 && echo py -3 || echo python3) \"${CLAUDE_PLUGIN_ROOT}\"/hooks/chekan_hook.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash|Agent|Task|Read|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$(command -v py >/dev/null 2>&1 && echo py -3 || echo python3) \"${CLAUDE_PLUGIN_ROOT}\"/hooks/chekan_hook.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
