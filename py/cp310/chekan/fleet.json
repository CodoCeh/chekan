{
 "claude": {
  "title": "Claude Code",
  "company": "Anthropic",
  "bin": [
   "claude"
  ],
  "run": [
   "claude",
   "-p",
   "{prompt}",
   "--permission-mode",
   "acceptEdits"
  ],
  "model_flag": "--model",
  "status": {
   "argv": [
    "claude",
    "auth",
    "status"
   ],
   "yes": "\"loggedIn\": true"
  },
  "login": [
   "claude",
   "auth",
   "login"
  ],
  "install": "https://claude.com/claude-code",
  "good_for": [
   "code",
   "text",
   "review"
  ]
 },
 "codex": {
  "title": "Codex",
  "company": "OpenAI",
  "bin": [
   "codex"
  ],
  "run": [
   "codex",
   "exec",
   "-s",
   "workspace-write",
   "-c",
   "sandbox_workspace_write.network_access=true",
   "-c",
   "model_auto_compact_token_limit=400000",
   "--skip-git-repo-check",
   "{prompt}"
  ],
  "model_flag": "-m",
  "status": {
   "argv": [
    "codex",
    "login",
    "status"
   ],
   "yes": "Logged in"
  },
  "login": [
   "codex",
   "login"
  ],
  "install": "npm install -g @openai/codex",
  "good_for": [
   "code",
   "review"
  ],
  "add_dir_flag": "--add-dir",
  "add_dirs": [
   "~/.cache/uv",
   "~/.cache/pip"
  ]
 },
 "cursor": {
  "title": "Cursor",
  "company": "Cursor",
  "bin": [
   "cursor-agent",
   "agent"
  ],
  "run": [
   "{bin}",
   "-p",
   "--force",
   "--trust",
   "{prompt}"
  ],
  "model_flag": "--model",
  "status": {
   "argv": [
    "{bin}",
    "status"
   ],
   "yes": "Logged in"
  },
  "login": [
   "{bin}",
   "login"
  ],
  "install": "https://cursor.com/cli",
  "good_for": [
   "code"
  ]
 },
 "antigravity": {
  "title": "Antigravity",
  "company": "Google",
  "bin": [
   "agy"
  ],
  "run": [
   "agy",
   "-p",
   "{prompt}",
   "--mode",
   "accept-edits"
  ],
  "model_flag": "--model",
  "status": null,
  "login": [
   "agy"
  ],
  "install": "https://antigravity.google",
  "good_for": [
   "code",
   "research"
  ]
 },
 "gemini": {
  "title": "Gemini CLI",
  "company": "Google",
